# --- LLM Provider ---
# groq | gemini
LLM_PROVIDER=groq

GROQ_API_KEY=your-groq-api-key-here
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Gemini / Google (dùng khi LLM_PROVIDER=gemini hoặc fallback)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.6-flash

# --- Chung ---
LLM_TEMPERATURE=0.0
MAX_CHAT_HISTORY=20
BACKEND_URL=http://api:8080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000"]

# --- Agent dự báo nhập hàng ---
DEFAULT_LOCATION=Ha Noi
SAFETY_STOCK_RATIO=0.2
FORECAST_LOOKBACK_DAYS=30

# --- API ngoài ---
# OpenWeather: dùng chung key cho thời tiết (One Call 3.0), chất lượng không khí
# (Air Pollution) và geocoding tên tỉnh -> toạ độ. Bỏ trống thì các tool này
# tự trả về thông báo "không lấy được" thay vì làm crash.
OPENWEATHER_API_KEY=
EXTERNAL_API_TIMEOUT=10
EXTERNAL_CACHE_TTL=1800
GEOCODE_CACHE_TTL=86400

# Google Trends (pytrends). Tắt nếu bị giới hạn tần suất (HTTP 429).
TRENDS_ENABLED=true

# --- Langfuse tracing (tùy chọn: bỏ trống để tắt tracing) ---
# Docker Compose tự override LANGFUSE_BASE_URL thành http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
